      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify((() => {\n  const r = $('Envoyer au DMS').first().json;\n  if (r.statusCode !== 200) return { ok: false, erreur: (r.body && r.body.error) || \"L'atelier est injoignable\" };\n  const b = r.body || {};\n  return { ok: true, numero: b.numero || '', complet: b.complet, datePossible: b.date || null };\n})()) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "https://techauto-one.vercel.app"
