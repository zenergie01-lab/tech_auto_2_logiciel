        "url": "http://IP-TAILSCALE-DU-PC:8080/api/ext/rdv",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.corps) }}",
        "options": {
