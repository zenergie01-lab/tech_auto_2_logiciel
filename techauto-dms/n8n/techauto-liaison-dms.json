    {
      "id": "5e0c9b1a-0000-4000-8000-000000000002",
      "name": "Lire la demande",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// L'appli RDV envoie du texte (text/plain) pour éviter la pré-vérification CORS : on relit le JSON.\nlet b = $input.first().json.body;\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\nif (b && typeof b === 'object' && !b.action && Object.keys(b).length === 1) {   // texte rangé comme une clé\n  try { b = JSON.parse(Object.keys(b)[0]); } catch (e) {}\n}\nb = b || {};\nconst rappel = b.action === 'rappel';\nreturn [{ json: {\n  action: rappel ? 'rappel' : 'demande',\n  corps: rappel ? { action: 'rappel', rappel: b.rappel || b } : { action: 'demande', rdv: b.rdv || b }\n} }];"
      }
    },
